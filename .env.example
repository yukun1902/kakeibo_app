# このファイルをコピーして .env を作り、自分の環境に合わせて書き換えてください
# 形式: postgres://ユーザー名:パスワード@ホスト:ポート/データベース名?sslmode=disable
DATABASE_URL=postgres://ユーザー名:パスワード@localhost:5432/kakeibo_app?sslmode=disable
PORT=8080
# JWT（ログインの証明書）の署名鍵。32文字以上のランダムな文字列にして、他人に教えないこと
# 作り方の例（Git Bash）: od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
JWT_SECRET=ここに長いランダムな文字列を書く
